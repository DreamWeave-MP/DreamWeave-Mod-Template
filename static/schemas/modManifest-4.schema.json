{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamweave-mp.github.io/DreamWeave-Mod-Template/schemas/modManifest-4.schema.json",
  "title": "DreamWeave project manifest (schema_version 4)",
  "description": "One project's identity, releases, artifacts and install semantics. Published at <site>/dreamweave/projects/<id>.json and found through <site>/dreamweave.json. Core fields are frozen for schema_version 4: an unknown core field is an error, new data goes in namespaced extensions.",
  "type": "object",
  "required": [
    "schema_version",
    "document",
    "project",
    "channels",
    "releases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "4"
    },
    "document": {
      "const": "project"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "channels": {
      "description": "Each channel's head: its highest-precedence release that is neither yanked nor deprecated.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "releases": {
      "description": "Newest first by precedence. Yanked and deprecated releases stay listed.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "uuid": {
      "description": "A project id: an RFC 9562 UUID in canonical lowercase form. Chosen once by the author; never derived from a name, host or URL.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": {
      "description": "Dot-separated release numbers (1 to 6), optional -prerelease and +build. How release numbers compare depends on the project's versioning scheme (numeric or decimal); pre-releases follow SemVer 2.0.0; build metadata is ignored.",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+){0,5}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "constraint": {
      "description": "* or comma-separated comparators (=, !=, >, >=, <, <=) that must all hold, evaluated with the target project's versioning scheme.",
      "type": "string",
      "pattern": "^\\s*(?:\\*|(?:>=|<=|!=|=|>|<)\\s*(?:0|[1-9][0-9]*)(?:\\.[0-9]+){0,5}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\s*,\\s*(?:>=|<=|!=|=|>|<)\\s*(?:0|[1-9][0-9]*)(?:\\.[0-9]+){0,5}(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)*)\\s*$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "person": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "notes": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "highlights": {
          "type": "string",
          "description": "CommonMark. Treat embedded HTML as untrusted."
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "breaking": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migration": {
          "type": "string",
          "minLength": 1
        },
        "known_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notice": {
      "type": "object",
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "requires",
            "recommends",
            "conflicts",
            "compatible",
            "replaces"
          ]
        },
        "project": {
          "$ref": "#/$defs/uuid"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*(:[a-z0-9][a-z0-9.-]*)?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/constraint"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "path",
        "required",
        "default",
        "requires",
        "conflicts",
        "suggested_with"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "description": "Directory inside the archive, or \".\" for its root. Forward slashes, no . or .. segments.",
          "type": "string",
          "pattern": "^(\\.|[^/\\\\]+(/[^/\\\\]+)*)$"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "group": {
          "$ref": "#/$defs/token"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "suggested_with": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "name",
        "select"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "select": {
          "enum": [
            "exactly-one",
            "at-most-one",
            "at-least-one",
            "any"
          ]
        }
      }
    },
    "openmw_component": {
      "type": "object",
      "required": [
        "data_directories",
        "content_files",
        "groundcover_files",
        "fallback_archives",
        "fallback_entries",
        "config",
        "requires_content"
      ],
      "additionalProperties": false,
      "properties": {
        "data_directories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "content_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groundcover_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback_archives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback_entries": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "config": {
          "type": "boolean"
        },
        "requires_content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "openmw": {
      "type": "object",
      "required": [
        "components",
        "requires_content",
        "settings"
      ],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/openmw_component"
          }
        },
        "requires_content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lua_api": {
          "$ref": "#/$defs/constraint"
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "key",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "extensions": {
      "description": "Namespaced extension data. `openmw` is defined here; any other namespace is dotted (org.tes3mp) and opaque to clients that do not know it.",
      "type": "object",
      "properties": {
        "openmw": {
          "$ref": "#/$defs/openmw"
        }
      },
      "propertyNames": {
        "pattern": "^(openmw|[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+)$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "kind": {
          "enum": [
            "publisher",
            "mirror"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "format",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "sigstore-bundle"
          ]
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "issuer": {
          "$ref": "#/$defs/url"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "format",
        "filename",
        "media_type",
        "size",
        "digests",
        "sources",
        "signatures"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "format": {
          "enum": [
            "flat",
            "bain",
            "fomod",
            "binary",
            "crate",
            "jpk",
            "jsw"
          ],
          "description": "How the artifact is laid out. flat, bain and fomod hold data for the game; binary holds a program built for one platform; crate is a Rust crate as crates.io serves it. jpk is a Jess package archive (JPK) and jsw a packed Jess workspace (JSW), an application with every package it runs, frozen; both are installed by Jess, never by a DreamWeave client. A Jess application's executables are binary artifacts like any other program's."
        },
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "description": "application/zip; application/gzip for crate; application/vnd.jess.jpk for jpk; application/vnd.jess.jsw for jsw."
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "digests": {
          "type": "object",
          "required": [
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "platform": {
          "type": "object",
          "required": [
            "os",
            "arch"
          ],
          "additionalProperties": false,
          "properties": {
            "os": {
              "enum": [
                "windows",
                "macos",
                "linux",
                "android"
              ]
            },
            "arch": {
              "enum": [
                "x86_64",
                "aarch64"
              ]
            },
            "variant": {
              "enum": [
                "portmaster",
                "muos"
              ],
              "description": "A build for one handheld environment of the platform: portmaster, the PortMaster framebuffer build; muos, the same build as a muOS app. Clients that do not know a variant skip the artifact."
            }
          },
          "description": "For a binary artifact: the platform it runs on. Clients pick the artifact for their own, and skip variants they do not know."
        },
        "jess": {
          "type": "object",
          "required": [
            "package",
            "jess_api",
            "content_digest",
            "dependencies"
          ],
          "additionalProperties": false,
          "properties": {
            "package": {
              "$ref": "#/$defs/jess_package_id"
            },
            "jess_api": {
              "type": "string",
              "minLength": 1,
              "description": "The package API the package declares, jess.toml's jess_api."
            },
            "content_digest": {
              "$ref": "#/$defs/sha256",
              "description": "The package's content digest as jess.toml and jess.lock know it: the digest of the package's payload, not of the archive file, which is digests.sha256. A lock pins this."
            },
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/jess_requirement"
              },
              "description": "The package's [dependencies] as declared, by package id. Stated so an index can show them; resolving them is Jess's job."
            }
          },
          "description": "For a jpk artifact: what the Jess package inside is. Required when format is jpk, and not allowed otherwise."
        },
        "jess_workspace": {
          "type": "object",
          "required": [
            "package",
            "builtin",
            "targets",
            "commands",
            "packages"
          ],
          "additionalProperties": false,
          "properties": {
            "package": {
              "$ref": "#/$defs/jess_package_id",
              "description": "The package that names the application: the one holding its default target, or the one package whose targets it exports. An index entry's jess_package names the same id."
            },
            "builtin": {
              "$ref": "#/$defs/jess_version",
              "description": "The version of jess's built-in package it was packed against, jsw.toml's builtin. A jess whose built-in package is compatible runs it; a client picks the newest release its jess can run."
            },
            "default": {
              "$ref": "#/$defs/jess_target",
              "description": "The target it runs when none is named, jsw.toml's default."
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/jess_target"
              },
              "description": "Every target it exports, jsw.toml's [[target]] entries."
            },
            "commands": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/jess_target"
              },
              "description": "The command names its exported targets declare, each with the target it runs: what installing it puts on a PATH."
            },
            "packages": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/jess_package_id"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "version",
                  "content_digest"
                ],
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "$ref": "#/$defs/jess_version"
                  },
                  "content_digest": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              },
              "description": "Every package it holds, by id: the exact version and content digest it pins. A frozen set, not requirements: an index shows it and resolves nothing from it."
            }
          },
          "description": "For a jsw artifact: what the packed workspace inside runs and holds, as its jsw.toml says. Required when format is jsw, and not allowed otherwise."
        },
        "layout": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "release_document": {
              "type": "string",
              "minLength": 1
            },
            "documentation": {
              "type": "string",
              "minLength": 1
            },
            "installer": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "binary"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "platform"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "jpk"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "jess"
            ]
          },
          "else": {
            "not": {
              "required": [
                "jess"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "jsw"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "jess_workspace"
            ]
          },
          "else": {
            "not": {
              "required": [
                "jess_workspace"
              ]
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "channel",
        "status",
        "source",
        "runtimes",
        "platforms",
        "provides",
        "relationships",
        "components",
        "groups",
        "extensions",
        "critical_extensions",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "channel": {
          "$ref": "#/$defs/token"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": [
            "available",
            "yanked",
            "deprecated"
          ]
        },
        "yanked": {
          "$ref": "#/$defs/notice"
        },
        "deprecated": {
          "$ref": "#/$defs/notice"
        },
        "source": {
          "type": "object",
          "required": [
            "repository"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "$ref": "#/$defs/url"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "release": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            }
          }
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "runtimes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/constraint"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "os",
              "arch"
            ],
            "additionalProperties": false,
            "properties": {
              "os": {
                "enum": [
                  "windows",
                  "macos",
                  "linux"
                ]
              },
              "arch": {
                "enum": [
                  "x86_64",
                  "aarch64"
                ]
              }
            }
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "critical_extensions": {
          "description": "Extensions a client must implement before it may claim to have installed this release. It may still download and verify the artifact.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "status",
        "game",
        "tags",
        "maintainers",
        "links",
        "integrations",
        "media",
        "credits",
        "versioning"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "mod",
            "library",
            "framework",
            "tool",
            "assets",
            "total-conversion",
            "documentation"
          ]
        },
        "status": {
          "enum": [
            "active",
            "maintenance",
            "experimental",
            "deprecated",
            "archived"
          ]
        },
        "game": {
          "$ref": "#/$defs/token"
        },
        "license": {
          "description": "An SPDX license expression.",
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maintainers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "links": {
          "type": "object",
          "required": [
            "page",
            "source",
            "issues"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/url"
          }
        },
        "integrations": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "nexusmods": {
              "type": "object",
              "required": [
                "game",
                "mod_id"
              ],
              "additionalProperties": false,
              "properties": {
                "game": {
                  "$ref": "#/$defs/token"
                },
                "mod_id": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "alt",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "image",
                  "video"
                ]
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "$ref": "#/$defs/url"
              },
              "thumbnail": {
                "$ref": "#/$defs/url"
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "featured": {
                "const": true
              }
            }
          }
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        },
        "versioning": {
          "description": "How this project's release numbers compare. numeric: as integers (0.9 < 0.82). decimal: after the first, like digits after a decimal point (0.82 < 0.9).",
          "enum": [
            "numeric",
            "decimal"
          ]
        }
      }
    },
    "jess_package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "maxLength": 200,
      "description": "A Jess package id: reverse-DNS, lowercase, as jess.toml's [package] id. Chosen by the package's author; proof of nothing about who publishes it."
    },
    "jess_requirement": {
      "type": "string",
      "pattern": "^[=^]?(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){0,2}$",
      "description": "A Jess version requirement as jess.toml writes one: ^1.2 (or 1.2, the same), =1.2.3."
    },
    "jess_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "description": "An exact Jess version, major.minor.patch with an optional pre-release: 1.2.0, 1.2.1-dev.57."
    },
    "jess_target": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*:[a-z0-9][a-z0-9._-]*$",
      "description": "A Jess target, <package id>:<target id>."
    }
  }
}
